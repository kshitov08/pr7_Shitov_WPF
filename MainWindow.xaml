<Window x:Class="pr7_Shitov_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr7_Shitov_WPF"
        xmlns:models="clr-namespace:pr7_Shitov_WPF.Models"
        xmlns:converters="clr-namespace:pr7_Shitov_WPF.Converters"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <converters:WeightConverter x:Key="Converter1"/>
        <converters:PriceStrikethroughConverter x:Key="Converter2"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="5">
            <StackPanel>
                <Label>Получатель</Label>
                <TextBox Text="{Binding Recipient,
UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel>
                <Label>Вес (гр.)</Label>
                <TextBox Text="{Binding Weight, Converter={StaticResource Converter1}, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel>
                <Label>Цена за кг</Label>
                <TextBox Text="{Binding RatePerKg, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel>
                <Label>Доплата</Label>
                <TextBox Text="{Binding Surcharge, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="5">
            <StackPanel>
                <Label>Получатель:</Label>
                <TextBlock Text="{Binding Recipient}"/>
            </StackPanel>
            <StackPanel>
                <Label>Вес:</Label>
                <TextBlock Text="{Binding Weight, StringFormat={}{0:F3} кг}"/>
            </StackPanel>
            <StackPanel Margin="0,3,0,0">
                <Label>Цена за кг:</Label>
                <TextBlock Text="{Binding RatePerKg, StringFormat={}{0:C}, ConverterCulture=ru-RU}"/>
            </StackPanel>
            <StackPanel Margin="0,2,0,0">
                <Label>Стоимость доставки:</Label>
                <TextBlock Text="{Binding DeliveryCost, UpdateSourceTrigger=PropertyChanged,
                    StringFormat={}{0:C}, ConverterCulture=ru-RU}" 
                           Foreground="{Binding Surcharge, Converter={StaticResource Converter2}}"/>
            </StackPanel>
            <StackPanel Margin="0,3,0,0">
                <Label>Доплата:</Label>
                <TextBlock Text="{Binding Surcharge, StringFormat={}{0:C}, ConverterCulture=ru-RU}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
